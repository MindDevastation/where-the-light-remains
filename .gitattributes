* text=auto eol=lf

# Godot / source text
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.flac binary
*.mp3 binary
*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.psd binary
*.kra binary
*.docx binary
*.pdf binary

# NOTE: Git LFS migration is intentionally not declared here until existing
# large blobs are actually migrated. Adding filter=lfs without migrating the
# current WAV history would create pointer-consistency warnings for clones.
