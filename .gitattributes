* text=auto eol=lf

# Godot / source text
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets kept in ordinary Git
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.flac binary
*.mp3 binary
*.gltf binary
*.psd binary
*.kra binary
*.docx binary
*.pdf binary

# Git LFS — forward-looking production masters/runtime binaries.
# These extensions are not currently present in the repository tree, so enabling
# LFS here does not create pointer inconsistencies for existing tracked files.
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text

# Existing WAV/audio history intentionally remains ordinary Git for now.
# A destructive history rewrite is not required to begin 3D production.
# Any later audio-history cleanup/migration must be a separate, explicitly
# validated maintenance task with fresh-clone and LFS-object retrieval checks.
